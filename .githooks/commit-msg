#!/bin/bash
# commit-msg hook — repo-tracked, activated via `git config core.hooksPath .githooks`
#
# Enforces the vulnerability-disclosure boundary from
# docs/sops/vulnerability-disclosure.md on COMMIT MESSAGES.
#
# This repository is PUBLIC. A commit message that says what is currently
# UNFIXED on a service we actually run is a disclosure — it tells a reader
# exactly where to aim and that nobody has closed it yet. Git history cannot
# be rewritten once pushed, so this has to be caught before the commit exists.
#
# What is blocked:
#   · CVE / GHSA identifiers, and the bare word "CVE"
#   · scanner vocabulary ("fixable", "will_not_fix", "criticals", "highs")
#   · counted or quantified vulnerability phrasing
#     ("13 fixable criticals", "one critical remains", "clears 4 CVEs")
#   · explicit unfixed-state statements
#     ("vulnerable to", "unpatched", "exploitable", "residual critical")
#
# What is allowed:
#   · `security_ref: F-xxxxxxxx` — the sanctioned pointer to the finding record
#   · plain version bumps with no vulnerability language
#   · describing a FIX without quantifying what remains
#
# Correct shape for a security-driven bump:
#
#     fix(app): image 1.2.3 -> 1.2.4
#
#     Patch release, no breaking changes in upstream notes.
#
#     security_ref: F-1db8884d
#
# Detail belongs on the finding record, not in git:
#     runbooks/policy-cli.py finding detail F-xxxxxxxx
#
# Escape hatch: `git commit --no-verify` bypasses this hook (as it does every
# hook). Use it only for a message that is genuinely a false positive, and see
# the SOP before deciding that it is.

set -e

MSG_FILE="$1"
[ -z "$MSG_FILE" ] && exit 0
[ -f "$MSG_FILE" ] || exit 0

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
DIM='\033[2m'
NC='\033[0m'

# Resolve python3: PATH, then mise shims, then `mise exec --`.
PY=""
if command -v python3 >/dev/null 2>&1; then
    PY="python3"
elif [ -x "$HOME/.local/share/mise/shims/python3" ]; then
    PY="$HOME/.local/share/mise/shims/python3"
elif command -v mise >/dev/null 2>&1; then
    PY="mise exec -- python3"
fi

if [ -z "$PY" ]; then
    # FAIL CLOSED. This guards against a permanent, unrewritable disclosure on
    # a public repo; silently skipping the scan because an interpreter is
    # missing is the wrong trade. Skipping must be a deliberate act.
    echo -e "${RED}✖ commit-msg: python3 not found — disclosure scan cannot run.${NC}" >&2
    echo -e "  Install python3 (or run inside mise), or bypass deliberately with" >&2
    echo -e "  ${DIM}git commit --no-verify${NC} if you have checked the message yourself." >&2
    echo -e "  Policy: ${YELLOW}docs/sops/vulnerability-disclosure.md${NC}" >&2
    exit 1
fi

# The Python below runs from a HEREDOC, so `__file__` is not this hook's path
# (it is "<stdin>"). Resolve the hooks dir in bash and pass it through, or the
# shared-library import silently fails to find the module and the fail-closed
# branch blocks every commit in the repo.
GITHOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export GITHOOKS_DIR

$PY - "$MSG_FILE" <<'PYEOF' 
import os
import re
import sys

RED = "\033[0;31m"
YELLOW = "\033[1;33m"
GREEN = "\033[0;32m"
DIM = "\033[2m"
NC = "\033[0m"

path = sys.argv[1]
with open(path, "r", encoding="utf-8", errors="replace") as fh:
    raw = fh.read()

# `git commit -v` appends the staged diff below a scissors line. Everything
# from there down is not part of the message and must not be scanned.
scissors = re.search(r"^#\s*-+\s*>8\s*-+.*$", raw, re.MULTILINE)
if scissors:
    raw = raw[: scissors.start()]

# Drop comment lines (git's own template guidance mentions nothing relevant,
# but a user's editor comments should never trip the scan).
lines = [ln for ln in raw.splitlines() if not ln.lstrip().startswith("#")]

if not any(ln.strip() for ln in lines):
    sys.exit(0)  # empty message — git will abort on its own

# ── What actually constitutes a disclosure ──────────────────────────────
#
# The trigger is DISCLOSURE, not vocabulary. Scanner words on their own
# ("fixable", "criticals") are how we legitimately talk ABOUT the audit
# tooling — e.g. "stop counting kernel-header packages as fixable criticals"
# is a parser change that reveals nothing. Blocking that trains everyone to
# reflexively --no-verify, which destroys the hook's value.
#
# So a vuln term only trips the hook when it is tied to something that makes
# it a statement about our fleet:
#   · an advisory IDENTIFIER (always disclosure, on its own)
#   · a NUMBER or quantifier next to it   ("13 fixable criticals")
#   · a residual/unfixed-state assertion  ("one critical remains")
#   · a named IMAGE REFERENCE on the same line ("postgres:17.11-x: 19 CRITICAL")
#
# The pattern library is SHARED with .githooks/pre-commit (which scans staged
# added lines). It lived inline here until 2026-08-18; that is precisely why
# the pre-commit side had none, and why the same fixture defect shipped twice
# in one evening. A second copy would drift — this codebase was bitten by a
# duplicated predicate earlier the same night.
import importlib.util as _ilu
_dp_path = os.path.join(os.environ.get("GITHOOKS_DIR", ""),
                        "lib", "disclosure_patterns.py")
if not os.path.exists(_dp_path):
    # Fail CLOSED. The module is repo-tracked beside this hook, so its absence
    # means a broken checkout, not a legitimate state — and silently skipping a
    # disclosure control on a public repo is the one outcome we cannot accept.
    sys.stderr.write(
        "commit-msg: missing .githooks/lib/disclosure_patterns.py — "
        "disclosure check cannot run. Restore it, or use --no-verify "
        "if you have verified the message yourself.\n")
    sys.exit(1)
_spec = _ilu.spec_from_file_location("disclosure_patterns", _dp_path)
_dp = _ilu.module_from_spec(_spec)
_spec.loader.exec_module(_dp)
# NB: intentionally NOT binding _dp.COMPILED here. That export exists only for
# back-compat and carries no acquittal data; binding it invites someone to
# scan it directly again and silently lose the §2.1 closed-gap allowances.

# `security_ref: F-xxxxxxxx` is the sanctioned reference form — a pointer,
# not a disclosure. Drop those lines before scanning.
scannable = [
    ln
    for ln in lines
    if not re.match(r"^\s*security_ref:\s*F-[0-9a-f]{8}\s*$", ln, re.IGNORECASE)
]

# Scan a WHITESPACE-NORMALIZED single string, not line by line. Commit bodies
# here are hard-wrapped at ~72 chars, so a multi-word pattern like "13 fixable
# criticals" routinely straddles a line break — per-line matching would miss it
# by accident, with no one trying to evade. Joining first closes that hole.
normalized = re.sub(r"\s+", " ", " ".join(scannable)).strip()


def sanitize(text):
    """Strip ANSI/CSI and other control characters before echoing back.

    The rejection banner exists to be READ by a human; a message containing
    e.g. an erase-display escape must not be able to repaint their terminal.
    """
    text = re.sub(r"\x1b\[[0-9;?]*[ -/]*[@-~]", "", text)
    text = re.sub(r"\x1b[@-_]", "", text)
    return "".join(ch if ch.isprintable() or ch == " " else "?" for ch in text)


# Route through dp.scan()/dp.scan_warn() rather than iterating COMPILED here.
# COMPILED is a back-compat 2-tuple export that carries NO acquittal data, so
# scanning it directly would reject the closed-gap phrasings the SOP (§2.1)
# explicitly publishes — "post-rebuild: 0 fixable CRITICAL" among them. One
# code path, one set of semantics: the library decides, the hook reports.
# The trailer is LINE-anchored and `normalized` is one joined line, so the
# library can never self-detect it here — detect it on the raw lines and hand
# the library the answer. Without this the sanctioned opt-out is inert in the
# only place it is meant to be used, leaving `--no-verify` as the sole escape.
_waived = bool(_dp.TOOLING_OPT_IN.search("\n".join(lines)))
violations = _dp.scan(normalized, waived=_waived)
advisories = _dp.scan_warn(normalized)

# WARN tier: real signal, measured false-positive rate against ordinary
# supply-chain prose, so it NAGS and never gates. Printed even when the commit
# is accepted — and deliberately before the reject banner, so it is not lost
# in the scrollback of a rejection.
if advisories:
    print("", file=sys.stderr)
    print(f"{YELLOW}⚠  disclosure advisory (not blocking){NC}", file=sys.stderr)
    for excerpt, matched, label in advisories:
        print(f"   · {label}: {sanitize(matched)[:90]}", file=sys.stderr)
    print(f"   Check it against {YELLOW}docs/sops/vulnerability-disclosure.md{NC} "
          f"§2.1 before you push.", file=sys.stderr)
    print("", file=sys.stderr)

if not violations:
    sys.exit(0)

out = sys.stderr
print("", file=out)
print(
    f"{RED}╔══════════════════════════════════════════════════════════════════╗{NC}",
    file=out,
)
print(
    f"{RED}║  COMMIT REJECTED — vulnerability-disclosure policy               ║{NC}",
    file=out,
)
print(
    f"{RED}╚══════════════════════════════════════════════════════════════════╝{NC}",
    file=out,
)
print("", file=out)
print(
    f"  Policy: {YELLOW}docs/sops/vulnerability-disclosure.md{NC}", file=out
)
print("", file=out)
print(
    "  This repository is PUBLIC. A commit message must not describe",
    file=out,
)
print(
    "  currently-unfixed vulnerability state on a service we run.",
    file=out,
)
print("", file=out)
print(f"  {RED}Offending content:{NC}", file=out)
for excerpt, hit, label in violations:
    print("", file=out)
    print(f"    {DIM}…{sanitize(excerpt)}{NC}", file=out)
    print(f"    {RED}  ^ matched {sanitize(repr(hit))} — {label}{NC}", file=out)
print("", file=out)
print(f"  {GREEN}How to fix:{NC}", file=out)
print("", file=out)
print(
    "    1. Move the detail onto the finding record (stays in the cluster DB,",
    file=out,
)
print("       never in git):", file=out)
print("", file=out)
print(
    f"         {DIM}runbooks/policy-cli.py finding detail F-xxxxxxxx{NC}",
    file=out,
)
print("", file=out)
print("    2. Reference it from the commit message instead:", file=out)
print("", file=out)
print(f"         {DIM}security_ref: F-xxxxxxxx{NC}", file=out)
print("", file=out)
print(
    "    3. Say what the change DOES, not what remains unfixed. e.g.", file=out
)
print("", file=out)
print(f"         {DIM}fix(app): image 1.2.3 -> 1.2.4{NC}", file=out)
print("", file=out)
print(f"         {DIM}Patch release, no breaking changes upstream.{NC}", file=out)
print("", file=out)
print(f"         {DIM}security_ref: F-1db8884d{NC}", file=out)
print("", file=out)
print(
    f"  {DIM}False positive? `git commit --no-verify` bypasses this hook.{NC}",
    file=out,
)
print(
    f"  {DIM}Read the SOP before deciding that it is one.{NC}",
    file=out,
)
print("", file=out)

sys.exit(1)
PYEOF
