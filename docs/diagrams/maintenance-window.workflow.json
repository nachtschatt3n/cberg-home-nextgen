  "cards": [
    {
      "dot": "cyan",
      "title": "Step 0 is unconditional",
      "items": [
        "Safe patch/minor updates apply at the START of every window — including unattended nightly runs",
        "The sweep only dry-runs and reports; it never applies"
      ]
    },
    {
      "dot": "amber",
      "title": "Autonomy classes",
      "items": [
        "AUTO-NIGHT runs unattended after clean supervised runs; backup-gated plans need a named gate PASS",
        "HUMAN-GATED or ambiguity → operator go/no-go; silence defers, never auto-runs"
      ]
    },
    {
      "dot": "rose",
      "title": "Rollback contract",
      "items": [
        "Every plan ships its own verification + rollback",
        "A failed health gate git-reverts the batch and Flux reconciles back"
      ]
    }
  ]
