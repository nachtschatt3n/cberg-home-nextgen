{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Maintenance-Window Pipeline",
    "locale": "en",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "safe-lane",
        "label": "Safe updates (Step 0)",
        "focus": [
          "wopen",
          "step0",
          "verify"
        ],
        "note": "Every window starts by applying the safe update batch — even unattended nightly runs."
      },
      {
        "id": "held-lane",
        "label": "Held updates",
        "focus": [
          "dryrun",
          "dispatch",
          "plan",
          "vet",
          "sequence"
        ],
        "note": "Non-safe updates get an executable plan and interference vetting before any window runs them."
      },
      {
        "id": "gates",
        "label": "Autonomy & rollback",
        "focus": [
          "sequence",
          "gonogo",
          "execute",
          "verify",
          "revert",
          "defer"
        ],
        "note": "Autonomy classes decide who approves; regressions auto-revert via git."
      }
    ]
  },
  "lanes": [
    {
      "id": "sweep",
      "label": "Daily Sweep (read-only)"
    },
    {
      "id": "planner",
      "label": "Upgrade Planner Agents"
    },
    {
      "id": "window",
      "label": "Maintenance-Window Agent"
    },
    {
      "id": "exceptions",
      "label": "Operator / Exceptions",
      "variant": "exception"
    }
