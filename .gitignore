# Trash
.DS_Store
Thumbs.db
# k8s
kubeconfig
talosconfig
# Talos generated machine configs — these embed the full cluster PKI (CA keys,
# bootstrap tokens, disk-encryption secrets). talhelper rewrites this directory's
# OWN .gitignore on every `genconfig` and lists node files by EXACT filename, so
# adding a 4th node would silently produce an untracked-but-not-ignored config
# that `git add -A` would commit to this PUBLIC repo. This rule is pattern-based
# and lives outside the generated directory, so it cannot be clobbered.
kubernetes/bootstrap/talos/clusterconfig/**
!kubernetes/bootstrap/talos/clusterconfig/.gitignore
.decrypted~*.yaml
*.agekey
*.pub
*.key
# Private
.private
.bin
.unifictl.yaml
*.sops.tmp.yaml
*.sops.yaml.bak
*-temp.yaml
# Ansible
.venv*
# Python
__pycache__/
*.py[cod]
# Taskfile
.task
# Brew
Brewfile.lock.json
# intellij
.idea
# Auto-generated runbook snapshots (never commit)
runbooks/*-current.md
# Guard against accidental duplicate outputs in docs/
docs/*-current.md
# Bootstrap
/config.yaml
cloudflared.json
.kube/

# Local build artifacts (generated PDFs, etc.)
scratch/

# Local Claude/Codex tooling artifacts (not part of GitOps)
.claude/scheduled_tasks.lock
.claude/worktrees/
