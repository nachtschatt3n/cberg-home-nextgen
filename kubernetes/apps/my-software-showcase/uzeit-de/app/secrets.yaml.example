# IMPORTANT: This is a template. In production, encrypt with SOPS:
# sops --encrypt secrets.yaml > secrets.yaml.enc
#
# To use:
# 1. Copy secrets.yaml.example to secrets.yaml
# 2. Fill in actual values (use strong random passwords)
# 3. Encrypt with sops (requires .sops.yaml configuration)
# 4. Add secrets.yaml.enc to git, keep secrets.yaml in .gitignore

apiVersion: v1
kind: Secret
metadata:
  name: uzeit-de-secrets
  namespace: my-software-showcase
type: Opaque
stringData:
  # Database credentials - CHANGE THESE!
  db.user: "typo3_prod"
  db.password: "CHANGE_ME_TO_STRONG_PASSWORD"

  # TYPO3 admin credentials - CHANGE THESE!
  typo3.admin.user: "admin"
  typo3.admin.password: "CHANGE_ME_TO_STRONG_PASSWORD"
  typo3.admin.email: "admin@showcase.local"

  # MySQL root password - CHANGE THESE!
  mysql.root.password: "CHANGE_ME_TO_STRONG_PASSWORD"

  # Encryption key for TYPO3
  encryption.key: "CHANGE_ME_TO_RANDOM_32_CHAR_STRING"
