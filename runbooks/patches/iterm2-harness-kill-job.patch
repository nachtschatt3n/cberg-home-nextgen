+async def handle_kill_job(sid, body=None, **_):
+    """Send a signal to the pane's foreground job (local addition, 2026-08-04).
+
+    Exists because a wedged full-context Claude TUI ignores edit keys from
+    send-key/send-text, leaving no remote way to clear it. Kills ONLY the
+    foreground job of the addressed pane. Body: {"signal": "TERM"|"INT"|"KILL"}
+    (default TERM). NOTE: patched into the brew Cellar file — re-apply after
+    `brew upgrade iterm2-harness` (see cberg memory project_operation_console_wedge).
+    """
+    import signal as _signal
+    session = await _find_session(sid)
+    if not session:
+        return 404, {
+            "error": f"Session '{sid}' not found",
+            "hint": "Call GET /api/v1/sessions to list current session_ids.",
+        }
+    sig_name = str((body or {}).get("signal", "TERM")).upper()
+    sig_map = {"TERM": _signal.SIGTERM, "INT": _signal.SIGINT, "KILL": _signal.SIGKILL}
+    if sig_name not in sig_map:
+        return 400, {"error": f"Unknown signal: '{sig_name}'", "hint": "Use TERM, INT or KILL."}
+    job_pid = await session.async_get_variable("jobPid")
+    try:
+        job_pid = int(job_pid)
+    except (TypeError, ValueError):
+        return 409, {"error": "No foreground job pid for this session",
+                     "jobPid": job_pid}
+    if job_pid <= 1:
+        return 409, {"error": f"Refusing to signal pid {job_pid}"}
+    job_name = await session.async_get_variable("jobName")
+    try:
+        os.kill(job_pid, sig_map[sig_name])
+    except ProcessLookupError:
+        return 409, {"error": f"Process {job_pid} not found (already exited?)"}
+    except PermissionError:
+        return 403, {"error": f"Not permitted to signal pid {job_pid}"}
+    return 200, {"ok": True, "pid": job_pid, "job_name": job_name, "signal": sig_name}
 
 
